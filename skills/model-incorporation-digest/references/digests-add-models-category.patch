index b99232c..be29d45 100644
--- a/website/assets/style.css
+++ b/website/assets/style.css
@@ -204,16 +204,40 @@ main {
   color: var(--text-strong);
   font-weight: 600;
 }
-.content th:nth-child(1),  .content td:nth-child(1)  { width: 14%; } /* Event */
-.content th:nth-child(2),  .content td:nth-child(2)  { width: 5%; }  /* Markers */
-.content th:nth-child(3),  .content td:nth-child(3)  { width: 9%; }  /* Dates */
-.content th:nth-child(4),  .content td:nth-child(4)  { width: 9%; }  /* Location */
-.content th:nth-child(5),  .content td:nth-child(5)  { width: 8%; }  /* Format · Type */
-.content th:nth-child(6),  .content td:nth-child(6)  { width: 7%; }  /* Cost */
-.content th:nth-child(7),  .content td:nth-child(7)  { width: 10%; } /* Bursary */
-.content th:nth-child(8),  .content td:nth-child(8)  { width: 6%; }  /* Priority */
-.content th:nth-child(9),  .content td:nth-child(9)  { width: 12%; } /* Engagement */
-.content th:nth-child(10), .content td:nth-child(10) { width: 20%; } /* Why it matters */
+/* Column widths are per family. These were written for event-discovery's ten-column
+   table, but were scoped to `.content`, so every other family's table inherited them —
+   a four-column digest was handed 14%/5%/9%/9% and rendered with a 5% column and a
+   third of the width unallocated. Each family now sets its own. */
+.family-events th:nth-child(1),  .family-events td:nth-child(1)  { width: 14%; } /* Event */
+.family-events th:nth-child(2),  .family-events td:nth-child(2)  { width: 5%; }  /* Markers */
+.family-events th:nth-child(3),  .family-events td:nth-child(3)  { width: 9%; }  /* Dates */
+.family-events th:nth-child(4),  .family-events td:nth-child(4)  { width: 9%; }  /* Location */
+.family-events th:nth-child(5),  .family-events td:nth-child(5)  { width: 8%; }  /* Format · Type */
+.family-events th:nth-child(6),  .family-events td:nth-child(6)  { width: 7%; }  /* Cost */
+.family-events th:nth-child(7),  .family-events td:nth-child(7)  { width: 10%; } /* Bursary */
+.family-events th:nth-child(8),  .family-events td:nth-child(8)  { width: 6%; }  /* Priority */
+.family-events th:nth-child(9),  .family-events td:nth-child(9)  { width: 12%; } /* Engagement */
+.family-events th:nth-child(10), .family-events td:nth-child(10) { width: 20%; } /* Why it matters */
+
+/* Model incorporations: four columns that add up to 100%, so nothing is left to the
+   browser to guess. Title takes the most because it is the only free text; the two
+   code-set columns are sized to their content — an eos identifier is eight characters,
+   and an author cell is "Name et al. (n)". */
+.family-models th:nth-child(1), .family-models td:nth-child(1) { width: 12%; } /* Model */
+.family-models th:nth-child(2), .family-models td:nth-child(2) { width: 40%; } /* Title */
+.family-models th:nth-child(3), .family-models td:nth-child(3) { width: 20%; } /* Task */
+.family-models th:nth-child(4), .family-models td:nth-child(4) { width: 28%; } /* Authors */
+
+/* This family's table is four wide columns of short strings rather than ten narrow ones,
+   so it can carry the body size instead of the compressed 0.78rem the event table needs.
+   Inline code in a cell is set to the same size, so the identifier and author columns do
+   not shrink away from the two prose columns beside them. */
+.family-models table { font-size: 0.845rem; }
+.family-models td code, .family-models th code {
+  font-size: 1em;
+  background: none;
+  padding: 0;
+}
 
 /* landing "card" list */
 .card-list { list-style: none; padding: 0; margin: 0; }
