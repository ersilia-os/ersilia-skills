{
  "about": "Every policy the checks apply. Feedback should change this file first; touch a script only when a rule cannot be expressed here. Severities: fix (wrong, broken or contradictory), trim (correct but costs context), consider (a judgement call).",
  "budgets": {
    "org": {
      "max_lines": 250,
      "max_section_lines": 40
    },
    "package-template": {
      "max_lines": 120,
      "max_section_lines": 30
    },
    "analysis-template": {
      "max_lines": 120,
      "max_section_lines": 30
    },
    "model-template": {
      "max_lines": 120,
      "max_section_lines": 30
    }
  },
  "last_updated": {
    "pattern": "Last updated:\\s*([A-Z][a-z]+ \\d{4})",
    "required_roles": [
      "org"
    ],
    "max_age_days": 120,
    "bump_on_apply": true
  },
  "required_sections": {
    "org": [
      "About Ersilia",
      "Agent behaviour"
    ],
    "package-template": [
      "Working with the user",
      "Code style",
      "Tests",
      "Dependencies",
      "README"
    ],
    "analysis-template": [
      "Repository structure",
      "Working with the user",
      "Version control",
      "README"
    ],
    "model-template": [
      "Working with the user",
      "Don't touch",
      "Versioning",
      "Ersilia ecosystem"
    ]
  },
  "placeholders": [
    "TODO",
    "TBD",
    "FIXME",
    "XXX",
    "lorem ipsum",
    "my_package",
    "Your Name"
  ],
  "vague_phrases": [
    "follow best practices",
    "be careful",
    "use common sense",
    "as appropriate",
    "where relevant",
    "always be aware"
  ],
  "canon": [
    {
      "id": "black",
      "pattern": "black[^\\n]{0,40}(format|lint)|(format|lint)[^\\n]{0,40}\\bblack\\b",
      "roles": [
        "org",
        "package-template",
        "analysis-template",
        "model-template"
      ],
      "message": "The canonical linter and formatter is ruff alone (the `ersilia` dialect, ruled 2026-07-28); mentioning `black` contradicts the templates."
    },
    {
      "id": "docstrings-numpy",
      "if": "docstrings?\\s*(:|\\*\\*|style|convention|format|must|should)",
      "require": "numpy",
      "roles": [
        "org",
        "package-template",
        "analysis-template",
        "model-template"
      ],
      "message": "Docstrings are mentioned without saying NumPy convention, the Ersilia standard."
    },
    {
      "id": "skills-pointer",
      "require": "ersilia-skills",
      "roles": [
        "org",
        "package-template",
        "analysis-template",
        "model-template"
      ],
      "message": "Every file should point agents to the ersilia-skills repository."
    },
    {
      "id": "skills-feedback",
      "require": "skill[^\\n]{0,160}\\b(improv|feedback|lesson|learn)|\\b(improv|feedback|lesson|learn)[^\\n]{0,160}skill",
      "roles": [
        "org",
        "package-template",
        "analysis-template",
        "model-template"
      ],
      "message": "Every file should ask agents to suggest improvements to a skill when using it teaches something new."
    },
    {
      "id": "plans",
      "pattern": "plan mode or ask",
      "roles": [
        "org",
        "package-template",
        "analysis-template",
        "model-template"
      ],
      "message": "The templates make plan mode mandatory for non-trivial work; 'plan mode or ask clarifying questions' makes it optional. Use one wording everywhere."
    }
  ],
  "duplication": {
    "min_words": 8,
    "overlap": 0.6,
    "lead_match": true,
    "within_file": "fix",
    "cross_file_pairs": [
      [
        "org",
        "package-template"
      ],
      [
        "org",
        "analysis-template"
      ]
    ],
    "cross_file": "consider",
    "cross_file_min_words": 40
  },
  "facts": {
    "org": "ersilia-os",
    "url_timeout": 15,
    "skip_url_hosts": [
      "localhost"
    ],
    "repo_like": "^(eos-[a-z0-9-]+|ersilia-[a-z0-9-]+|eos[a-z]+)$",
    "not_repos": [
      "ersilia-os",
      "ersilia-workspace"
    ]
  },
  "connectors": {
    "drive_section": "Google Drive",
    "airtable_section": "Airtable",
    "drive_ignore": [],
    "airtable_ignore": []
  },
  "bloat": {
    "tree_markers": [
      "├──",
      "└──"
    ],
    "overview_pattern": "^This is (an?|the) [^.]{0,120}(repository|repo|package|project|guide|template)\\b",
    "why": "Studies of AGENTS.md/CLAUDE.md files found overviews and folder trees do not help agents and cost tokens (Gloaguen et al. 2026, arXiv:2602.11988); agents can list the repo themselves."
  },
  "hooks": {
    "trigger": "\\b(never|must not|do not|don't|not allowed)\\b",
    "actions": [
      {
        "pattern": "push(ing)? to `?main",
        "suggest": "a permission rule denying `git push` to main, or branch protection"
      },
      {
        "pattern": "data/raw",
        "suggest": "a permission rule denying Edit/Write on `data/raw/**`"
      },
      {
        "pattern": "secret|credential|api key|password",
        "suggest": "a PreToolUse hook that blocks commits containing secrets (or a pre-commit secret scanner)"
      },
      {
        "pattern": "git add|commit (data|datasets|outputs|checkpoints)",
        "suggest": "a .gitignore entry plus a PreToolUse hook on `git add`"
      },
      {
        "pattern": "hand-edit|edit the local yaml|edit them",
        "suggest": "a permission rule denying Edit on those paths"
      }
    ],
    "why": "CLAUDE.md is advisory; Claude Code docs recommend hooks or permissions for rules that must always hold."
  },
  "reality": {
    "roles": [
      "package-template",
      "analysis-template",
      "model-template"
    ],
    "config_files": [
      "pyproject.toml",
      "requirements.txt",
      "install.yml"
    ],
    "tools": {
      "package-template": [
        "ruff",
        "pytest"
      ],
      "analysis-template": [
        "ruff",
        "stylia"
      ],
      "model-template": [
        "ersilia-pack-utils"
      ]
    },
    "path_pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]*)+$|^[A-Za-z0-9_-]+\\.(py|yml|yaml|csv|json|sh|toml|txt|md)$",
    "skip_line": "\\b(create|when first needed|rename|e\\.g\\.|for example|optional(ly)?|if the package|gitignored|not in git|numbered|naming convention)\\b",
    "skip_span": "(YYYY|\\bNN\\b|<|\\*|\\.\\.\\.)"
  }
}
