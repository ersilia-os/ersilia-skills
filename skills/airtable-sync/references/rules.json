  "grants": {
    "_doc": "Grants are checked against the Grants shared drive: one folder per application inside year folders (collect_grant_folders.py). A folder is paired with at most one row submitted within year_window years that shares a distinctive word (row name, short name, description, funder name or acronym); best pairs first (name, short-name and funder words score 2, description words 1, each year apart -2). known_pairs pins pairs the user confirmed ({folder key: record id}). Rows whose status is in stale_statuses more than stale_after_days after submission are flagged. Every create needs the judgement fields, filled from the folder contents. A pair needs min_score; an unpaired folder's reason names its closest row so the user can pin it.",
    "since_year": 2020,
    "year_window": 1,
    "known_pairs": {
      "grant:2023/GC-ADDA4TB": "recphosvzd94AIh8Q",
      "grant:2026/GCADDA4TB_FollowUp": "recqithufQYNpvoP8",
